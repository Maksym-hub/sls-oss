# slsflow Console Environment Variables
# Copy to .env.local for local development
# Existing VITE_* Vercel env vars are auto-mapped in next.config.mjs

# REQUIRED: Server-side API Gateway URL (used by Route Handlers, never exposed to client)
API_GATEWAY_URL=https://xxx.execute-api.us-east-1.amazonaws.com/api

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_ENABLED=false
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_COGNITO_REGION=us-east-1
