{
  "Comment": "Interactive Slack Notification - sends alert with action buttons",
  "QueryLanguage": "JSONata",
  "StartAt": "Prepare_Slack_Message",
  "States": {
    "Prepare_Slack_Message": {
      "Type": "Pass",
      "Comment": "Prepare Slack message with action URLs via console API",
      "Output": "{% ( $rawInput := $states.input.error.Input; $isJson := $exists($rawInput) and ($rawInput = '{}' or $substring($rawInput, 0, 2) = '{\"'); $parsedInput := $isJson ? $parse($rawInput) : $states.input; $executionName := $exists($parsedInput.execution_name) ? $parsedInput.execution_name : 'unknown'; $pipelineName := $exists($parsedInput.pipeline_name) ? $parsedInput.pipeline_name : 'unknown'; $taskName := $exists($parsedInput.task_name) ? $parsedInput.task_name : 'unknown'; $slackChannel := $exists($states.input.slack_channel) ? $states.input.slack_channel : ($exists($parsedInput.slack_channel) ? $parsedInput.slack_channel : '${slack_channel_default}'); $orchestrationToken := $exists($states.input.token) ? $states.input.token : ''; $hasToken := $orchestrationToken != ''; $smParts := $exists($states.input.error.StateMachineArn) ? $split($states.input.error.StateMachineArn, ':') : []; $failedSfnName := $count($smParts) > 0 ? $smParts[$count($smParts) - 1] : $taskName; $e := $states.input.error; $errorText := $type($e) = 'string' ? $e : ($exists($e.Error) ? $e.Error : ($exists($e.Status) ? $e.Status : 'Unknown')); $directArn := $exists($states.input.task_execution_arn) and $states.input.task_execution_arn != '' ? $states.input.task_execution_arn : ''; $causeArn := $directArn = '' and $exists($e.Cause) and $substring($e.Cause, 0, 1) = '{' ? ($causeJson := $parse($e.Cause); $exists($causeJson.ExecutionArn) ? $causeJson.ExecutionArn : '') : ''; $taskArn := $directArn != '' ? $directArn : $causeArn; $wrapperArn := $states.input.wrapper_executionArn; { 'slack_channel': $slackChannel, 'pipeline_name': $pipelineName, 'task_name': $taskName, 'execution_name': $executionName, 'failed_sfn_name': $failedSfnName, 'error': $errorText, 'has_token': $hasToken, 'task_execution_arn': $taskArn, 'wrapper_execution_arn': $wrapperArn, 'token': $orchestrationToken, 'slack_mentions': $exists($states.input.slack_mentions) and $states.input.slack_mentions != '' ? $states.input.slack_mentions : '${default_slack_mentions}' } ) %}",
      "Next": "Check_Has_Token"
    },
    "Check_Has_Token": {
      "Type": "Choice",
      "Comment": "Route to different Slack messages based on token availability",
      "Choices": [
        {
          "Condition": "{% $states.input.has_token %}",
          "Next": "Send_Full_Slack_Message"
        }
      ],
      "Default": "Send_Restart_Only_Message"
    },
    "Send_Full_Slack_Message": {
      "Type": "Task",
      "Comment": "POST to Slack with action buttons (has orchestration token)",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "Authentication": {
          "ConnectionArn": "${connection_arn}"
        },
        "ApiEndpoint": "${slack_webhook_endpoint}",
        "Method": "POST",
        "RequestBody": {
          "channel": "{% $states.input.slack_channel %}",
          "icon_url": "https://cdn-icons-png.flaticon.com/512/2248/2248485.png",
          "username": "Interactive Choice",
          "attachments": [
            {
              "color": "#E01E5A",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": "{% ':red_circle: *Task Failed — Action Required*\\n\\n*Pipeline:*  *`' & $states.input.pipeline_name & '`*\\n*Task:*  *`' & $states.input.task_name & '`*\\n*Error:*  *`' & $states.input.error & '`*' %}"
                  }
                },
                {
                  "type": "divider"
                },
                {
                  "type": "actions",
                  "elements": [
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Skip Task",
                        "emoji": true
                      },
                      "url": "{% '${console_api_endpoint}/api/action/skip?execution_name=' & $encodeUrlComponent($states.input.execution_name) %}",
                      "action_id": "skip-button",
                      "style": "primary"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Mark Success",
                        "emoji": true
                      },
                      "style": "primary",
                      "url": "{% '${console_api_endpoint}/api/action/success?execution_name=' & $encodeUrlComponent($states.input.execution_name) %}",
                      "action_id": "success-button"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Restart Task",
                        "emoji": true
                      },
                      "url": "{% '${console_api_endpoint}/api/action/restart?execution_name=' & $encodeUrlComponent($states.input.execution_name) %}",
                      "action_id": "restart-button"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Fail Pipeline",
                        "emoji": true
                      },
                      "style": "danger",
                      "url": "{% '${console_api_endpoint}/api/action/fail?execution_name=' & $encodeUrlComponent($states.input.execution_name) %}",
                      "action_id": "fail-button"
                    }
                  ]
                },
                {
                  "type": "actions",
                  "elements": [
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Task SFN",
                        "emoji": true
                      },
                      "url": "{% $states.input.task_execution_arn != '' ? ('https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.task_execution_arn)) : ('https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.wrapper_execution_arn)) %}",
                      "action_id": "task-console-button"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Wrapper SFN",
                        "emoji": true
                      },
                      "url": "{% 'https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.wrapper_execution_arn) %}",
                      "action_id": "wrapper-console-button"
                    }
                  ]
                },
                {
                  "type": "context",
                  "elements": [
                    {
                      "type": "mrkdwn",
                      "text": "{% '`' & $states.input.execution_name & '`  · Waiting for decision (5h timeout) · CC: ' & $states.input.slack_mentions %}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Send_Restart_Only_Message": {
      "Type": "Task",
      "Comment": "POST to Slack with Restart only (no orchestration token - standalone run)",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "Authentication": {
          "ConnectionArn": "${connection_arn}"
        },
        "ApiEndpoint": "${slack_webhook_endpoint}",
        "Method": "POST",
        "RequestBody": {
          "channel": "{% $states.input.slack_channel %}",
          "icon_url": "https://cdn-icons-png.flaticon.com/512/2248/2248485.png",
          "username": "Interactive Choice",
          "attachments": [
            {
              "color": "#E01E5A",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": "{% ':red_circle: *Task Failed (Standalone)*\\n\\n*Pipeline:*  *`' & $states.input.pipeline_name & '`*\\n*Task:*  *`' & $states.input.task_name & '`*\\n*Error:*  *`' & $states.input.error & '`*' %}"
                  }
                },
                {
                  "type": "context",
                  "elements": [
                    {
                      "type": "mrkdwn",
                      "text": "Standalone run — Skip/Fail not available (no parent pipeline)."
                    }
                  ]
                },
                {
                  "type": "divider"
                },
                {
                  "type": "actions",
                  "elements": [
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Restart Task",
                        "emoji": true
                      },
                      "style": "primary",
                      "url": "{% '${console_api_endpoint}/api/action/restart?execution_name=' & $encodeUrlComponent($states.input.execution_name) %}",
                      "action_id": "restart-button"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Task SFN",
                        "emoji": true
                      },
                      "url": "{% $states.input.task_execution_arn != '' ? ('https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.task_execution_arn)) : ('https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.wrapper_execution_arn)) %}",
                      "action_id": "task-console-button"
                    },
                    {
                      "type": "button",
                      "text": {
                        "type": "plain_text",
                        "text": "Wrapper SFN",
                        "emoji": true
                      },
                      "url": "{% 'https://${aws_region}.console.aws.amazon.com/states/home?region=${aws_region}#/v2/executions/details/' & $encodeUrlComponent($states.input.wrapper_execution_arn) %}",
                      "action_id": "wrapper-console-button"
                    }
                  ]
                },
                {
                  "type": "context",
                  "elements": [
                    {
                      "type": "mrkdwn",
                      "text": "{% '`' & $states.input.execution_name & '`  · CC: ' & $states.input.slack_mentions %}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  }
}