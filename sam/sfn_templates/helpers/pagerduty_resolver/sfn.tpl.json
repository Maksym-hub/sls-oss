{
  "Comment": "Resolve PagerDuty alert when task succeeds after previous failure",
  "QueryLanguage": "JSONata",
  "StartAt": "Check_Routing_Key",
  "States": {
    "Check_Routing_Key": {
      "Type": "Choice",
      "Comment": "Only resolve if routing key is configured",
      "Choices": [
        {
          "Condition": "{% '${pagerduty_routing_key}' != '' %}",
          "Next": "Build_Resolve_Payload"
        }
      ],
      "Default": "Skip_Resolve"
    },
    "Build_Resolve_Payload": {
      "Type": "Pass",
      "Comment": "Prepare PagerDuty resolve payload - same dedup_key as trigger",
      "Output": "{% { 'original': $states.input, 'pagerduty': { 'routing_key': '${pagerduty_routing_key}', 'event_action': 'resolve', 'dedup_key': $states.input.pipeline_name & '/' & $states.input.task_name & '/' & $states.input.date } } %}",
      "Next": "Send_PagerDuty_Resolve"
    },
    "Send_PagerDuty_Resolve": {
      "Type": "Task",
      "Comment": "POST resolve to PagerDuty Events API v2",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "https://events.pagerduty.com/v2/enqueue",
        "Method": "POST",
        "Headers": {
          "Content-Type": "application/json"
        },
        "Authentication": {
          "ConnectionArn": "${connection_arn}"
        },
        "RequestBody": "{% $states.input.pagerduty %}"
      },
      "Output": "{% { 'status': 'resolved', 'task_name': $states.input.original.task_name, 'execution_name': $states.input.original.execution_name } %}",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "PagerDuty call failed - log but don't break success flow",
          "Output": "{% { 'status': 'resolve_failed', 'task_name': $states.input.original.task_name, 'error': $string($states.errorOutput) } %}",
          "Next": "Resolve_Failed"
        }
      ],
      "Next": "Resolve_Sent",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ]
    },
    "Resolve_Sent": {
      "Type": "Pass",
      "Comment": "Resolve successfully sent to PagerDuty",
      "End": true
    },
    "Resolve_Failed": {
      "Type": "Pass",
      "Comment": "Failed to send resolve - continue gracefully (alert stays open)",
      "End": true
    },
    "Skip_Resolve": {
      "Type": "Pass",
      "Comment": "PagerDuty not configured - skip",
      "Output": {
        "status": "skipped",
        "reason": "pagerduty_routing_key not configured"
      },
      "End": true
    }
  }
}
